# Copy this file to .env and fill in your own values.

# Your local MySQL database: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The database must exist (CREATE DATABASE tech_commerce_db;).
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL="mysql://root:your_password@localhost:3306/tech_commerce_db"

# Public address of the images this server serves (public/images).
# Locally this is the server itself; online it is the deployed API URL + /images.
IMAGE_BASE_URL="http://localhost:5000/images"

# Secret used to sign login tokens. Use a long random value and never share it.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Address of the React client. Only this origin may call the API with cookies (CORS).
CLIENT_URL="http://localhost:5173"

# Optional: server port (default 5000).
# PORT=5000

# Set to "production" when deployed (login cookie becomes https-only).
# NODE_ENV=production
