# Copy this file to .env.prod and fill in your own values.
# .env.prod is never committed. Used by:
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d

# Version of the images on Docker Hub (marioboseski/tech-commerce-*:<tag>).
IMAGE_TAG=1.0.0

# Address people open in the browser (no trailing slash).
# Without a domain: http://localhost   With a domain: https://your-domain.com
CLIENT_URL=http://localhost

# Port on the host. 80 is the normal HTTP port.
HTTP_PORT=80

# Database passwords. Use long random values with letters and numbers only
# (other characters would need URL-encoding in the database address).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=techstore
MYSQL_PASSWORD=change-me

# Secret that signs login tokens. Long and random; never reuse the dev value.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
