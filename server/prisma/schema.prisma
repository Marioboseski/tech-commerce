generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  role Role @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  favorites    Favorite[]
  cartItems    CartItem[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                 Int                  @id @default(autoincrement())
  sku                String               @unique @db.VarChar(50)
  name               String               @db.VarChar(255)
  description        String               @db.Text
  price              Decimal              @db.Decimal(12, 2)
  imageUrl           String?              @map("image_url") @db.VarChar(500)
  categoryId         Int                  @map("category_id")
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  laptopDetails      LaptopDetails?
  mobilePhoneDetails MobilePhoneDetails?
  computerDetails    ComputerDetails?
  consoleDetails     ConsoleDetails?
  tabletDetails      TabletDetails?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  favorites          Favorite[]
  cartItems          CartItem[]

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("favorites")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("cart_items")
}

model LaptopDetails {
  id           Int     @id @default(autoincrement())
  productId    Int     @unique @map("product_id")
  screenSize   String  @map("screen_size") @db.VarChar(50)
  ram          String  @db.VarChar(50)
  processor    String  @db.VarChar(255)
  storage      String  @db.VarChar(100)
  graphicsCard String  @map("graphics_card") @db.VarChar(255)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("laptop_details")
}

model MobilePhoneDetails {
  id         Int     @id @default(autoincrement())
  productId  Int     @unique @map("product_id")
  screenSize String  @map("screen_size") @db.VarChar(50)
  ram        String  @db.VarChar(50)
  storage    String  @db.VarChar(100)
  processor  String  @db.VarChar(255)
  battery    String  @db.VarChar(100)
  camera     String  @db.VarChar(100)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("mobile_phone_details")
}

model ComputerDetails {
  id           Int     @id @default(autoincrement())
  productId    Int     @unique @map("product_id")
  processor    String  @db.VarChar(255)
  ram          String  @db.VarChar(50)
  storage      String  @db.VarChar(100)
  graphicsCard String  @map("graphics_card") @db.VarChar(255)
  formFactor   String  @map("form_factor") @db.VarChar(100)
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("computer_details")
}

model ConsoleDetails {
  id              Int     @id @default(autoincrement())
  productId       Int     @unique @map("product_id")
  manufacturer    String  @db.VarChar(100)
  storage         String  @db.VarChar(100)
  resolution      String  @db.VarChar(100)
  maxPlayers      String  @map("max_players") @db.VarChar(100)
  connectivity    String  @db.VarChar(255)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("console_details")
}

model TabletDetails {
  id         Int     @id @default(autoincrement())
  productId  Int     @unique @map("product_id")
  screenSize String  @map("screen_size") @db.VarChar(50)
  ram        String  @db.VarChar(50)
  storage    String  @db.VarChar(100)
  processor  String  @db.VarChar(255)
  battery    String  @db.VarChar(100)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("tablet_details")
}